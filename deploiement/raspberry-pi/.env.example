# Réglages du serveur de Mine Explorer sur le Raspberry Pi. Sur le Pi : cp .env.example .env, puis remplir
# (voir LISEZMOI.md, étape 6). Le fichier .env contient des secrets : il reste sur le Pi, jamais dans git ni dans un message.

# Base PostgreSQL (interne, jamais publiée)
POSTGRES_DB=mine
POSTGRES_USER=mine
# Compte principal, propriétaire du schéma (migrations) : généré sur le Pi
POSTGRES_PASSWORD=
# Compte de l'appli, limité aux données : généré sur le Pi
MINE_APP_PASSWORD=

# Client OAuth Google (console Google Cloud, voir LISEZMOI.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Modérateurs de la discussion (facultatif) : identifiant de joueur, l'« id » en tête de « Télécharger mes données »
# dans le Profil du jeu. Plusieurs : séparés par des virgules, sans espace.
MINE_MODERATORS=
