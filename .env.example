# Réglages du docker compose en local. Copier en .env (ignoré par git) pour les changer.
# Aucun secret ici : le serveur n'a pas encore de base ni de compte. Sur Coolify, rien à régler : son proxy expose le jeu.

# Port local du jeu (docker-compose.override.yml)
FRONTEND_PORT=8080
# Port local du serveur Spring Boot (docker-compose.override.yml)
BACKEND_PORT=8081
